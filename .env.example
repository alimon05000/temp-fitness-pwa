# Static frontend: public URL only, never put an API key here.
VITE_BASE_PATH=/
VITE_COACH_API_URL=
# Main backend: use Cloudflare Workers Secrets for the key and access code.
# Vars (base URL/model/origin) are configured in wrangler.jsonc.
TOOKEN_API_KEY=
TOOKEN_BASE_URL=https://tooken.club/v1
TOOKEN_MODEL=gpt-6.1-sol
COACH_ACCESS_CODE=
ALLOWED_ORIGIN=https://YOUR_LOGIN.github.io
# Only required for the optional Node/Vercel adapter, not Cloudflare:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
