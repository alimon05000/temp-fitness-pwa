# Static frontend: public URL only, never put an API key here.
VITE_BASE_PATH=/
VITE_COACH_API_URL=
# Server-only, set in Vercel Environment Variables:
TOOKEN_API_KEY=
TOOKEN_BASE_URL=https://tooken.club/v1
TOOKEN_MODEL=gpt-6.1-sol
COACH_ACCESS_CODE=
ALLOWED_ORIGIN=https://YOUR_LOGIN.github.io
# Mandatory in production when enabling the paid provider:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
